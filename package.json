{
  "name": "@caipj/dsh-task-manager",
  "version": "1.1.1",
  "private": false,
  "type": "module",
  "description": "Task manager for the DeepSeek Harness chat: tasks proposed by the model or added by the user, shown in a draggable floating panel, with origin badges and a confirm-before-done flow — click a task to hand it to the model.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "task-manager",
    "tasks",
    "todo",
    "plugin"
  ],
  "license": "MIT",
  "author": "caipanjin",
  "homepage": "https://github.com/caipanjin/dsh-task-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caipanjin/dsh-task-manager.git"
  },
  "bugs": {
    "url": "https://github.com/caipanjin/dsh-task-manager/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
